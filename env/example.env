# Bu dosyayı kopyalayın: env/dev.env, env/staging.env, env/prod.env
# Gerçek değerler içeren .env dosyaları git'e EKLENMEZ (.gitignore).
#
# Çalıştırma:
#   flutter run --dart-define-from-file=env/dev.env
#
# Not: İstemci uygulamaya gömülen her değer tersine mühendislikle okunabilir.
# AI / yemek veritabanı gibi gizli anahtarlar istemcide TUTULMAMALI;
# bunlar backend proxy (ör. Cloud Functions) üzerinden kullanılmalıdır.
# Buraya yalnızca "public" nitelikteki yapılandırmalar yazılmalıdır.

APP_ENV=dev
APP_NAME=Diyet Programı (Dev)

# Backend / proxy uç noktaları
API_BASE_URL=https://api.example.com
# Boş veya example.com ise asistan yapılandırılmamış sayılır (sahte yanıt yok).
# Buraya OpenAI/Gemini anahtarı YAZMAYIN. Yalnızca sizin backend proxy adresiniz.
AI_PROXY_BASE_URL=https://ai.example.com
# İsteğe bağlı, gizli olmayan proxy ayarları.
# AI_MODEL=
# AI_TIMEOUT_SECONDS=20
# AI_MAX_OUTPUT_TOKENS=512
# AI_MAX_INPUT_CHARS=6000
# AI_MAX_MESSAGE_CHARS=2000
# AI_MAX_REQUESTS_PER_MINUTE=8
# AI_MAX_RETRIES=0
# Fotoğraf tanıma sınırları. Sağlayıcı anahtarı değildir.
# FOOD_VISION_MAX_IMAGE_BYTES=1500000
# FOOD_VISION_MAX_IMAGE_DIMENSION=1280
# FOOD_VISION_JPEG_QUALITY=80
# VOICE_MAX_DURATION_SECONDS=30
# Yiyecek veritabanı. Boş veya example.com ise Open Food Facts kullanılır
# (API anahtarı gerekmez; ODbL atıfı arayüzde gösterilir).
# Kendi proxy'niz varsa adresi yazın; Firebase ID token gönderilmez.
FOOD_API_BASE_URL=
# Open Food Facts User-Agent iletişim e-postası (AppName/Version (email)).
# Gerçek bir iletişim adresi yazın; boşsa mevcut User-Agent korunur.
FOOD_API_CONTACT_EMAIL=

# Gizlilik Politikası HTML sayfası (mağaza + uygulama içi).
# Boş / example.com / geçersiz → Ayarlar'da açılmaz (güvenli).
# Kaynak: privacy-policy.html ve docs/privacy-policy.html (GitHub Pages /docs).
# origin: https://github.com/matematikciSeher/diyet-programi
PRIVACY_POLICY_URL=https://matematikciSeher.github.io/diyet-programi/privacy-policy.html
# Gizlilik iletişim e-postası. Gerçek adres yoksa boş bırakın; uydurmayın.
PRIVACY_CONTACT_EMAIL=

# Public SDK anahtarları (RevenueCat public key gibi)
REVENUECAT_API_KEY_IOS=
REVENUECAT_API_KEY_ANDROID=

# Özellik bayrakları
ENABLE_ANALYTICS=false
ENABLE_CRASH_REPORTING=false
# Debug/dev: true kalabilir. Release derlemede bu bayrak yok sayılır (her zaman false).
USE_FAKE_SERVICES=true

# --- Production (env/prod.env; git'e eklenmez) ---
# APP_ENV=prod
# USE_FAKE_SERVICES=false
# FOOD_API_CONTACT_EMAIL=
# (Gerçek iletişim e-postasını siz yazın; boşsa OFF User-Agent e-postasız kalır.)

# Firebase (flutterfire configure veya CI dart-define). Değerleri koda gömmeyin.
# google-services.json / GoogleService-Info.plist üretilmeden uygulama
# çevrimdışı (local-first) çalışır. Aşağıdaki satırları doldurmayın; gerçek
# değerler env/dev.env içinde tutulur ve git'e eklenmez.
# FIREBASE_API_KEY=
# FIREBASE_APP_ID=
# FIREBASE_MESSAGING_SENDER_ID=
# FIREBASE_PROJECT_ID=
# FIREBASE_STORAGE_BUCKET=
# FIREBASE_AUTH_DOMAIN=
# FIREBASE_IOS_BUNDLE_ID=
# FIREBASE_ANDROID_CLIENT_ID=
# FIREBASE_IOS_CLIENT_ID=
# GOOGLE_SERVER_CLIENT_ID=

